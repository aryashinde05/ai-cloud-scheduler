# Root environment variables (used by backend when run locally)
#
# Copy to `.env` at the repo root for local development.

# ---- Backend (FastAPI) ----
# Database connection for SQLAlchemy.
# Default used by code if unset: sqlite:///./finops.db
DATABASE_URL=sqlite:///./finops.db

# JWT secret used by `backend/app/api/auth_endpoints.py`
SECRET_KEY=dev-secret-key-change-in-production

# JWT secret used by `backend/app/core/auth.py` (some endpoints reference this auth system)
JWT_SECRET_KEY=dev-jwt-secret-change-in-production

ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allow the frontend dev server to call the API
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Encryption key for stored credentials (Fernet key or passphrase)
# If unset the backend generates one at startup (not ideal for persistence).
ENCRYPTION_KEY=change-me

# Optional: run without enforcing auth on protected endpoints that use `app.core.auth`
DEMO_MODE=false

# ---- Optional cloud credentials (only needed for live AWS/Azure calls) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ---- Optional Supabase (backend runs without it) ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- Optional OpenAI (AI assistant features) ----
OPENAI_API_KEY=

