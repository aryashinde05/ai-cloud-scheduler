# Backend-specific env file (loaded when running from `backend/`)
#
# Copy to `backend/.env` if you prefer keeping backend env separate.

DATABASE_URL=sqlite:///./finops.db
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=dev-jwt-secret-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

ENCRYPTION_KEY=change-me
DEMO_MODE=false

# Safety gate for real AWS actions (stop instances / delete volumes)
# Set to true ONLY when you intend to allow execution.
AUTO_MODE_ENABLED=false

# Optional integrations
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
OPENAI_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Used by scheduler, optimization, and ASG endpoints when no DB account region is set
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=

# Smart Scheduler: when false, cron jobs do not call start/stop (recommendations only)
SCHEDULER_EXECUTION_ENABLED=false
# Hourly USD estimate above which a resource may be flagged for cost-aware hints
SCHEDULER_COST_STOP_THRESHOLD=0.10
# Default $/hr when estimating savings if no hourly rate is stored on the schedule
SCHEDULER_DEFAULT_HOURLY_USD=0.08
# Optional: SNS topic for scheduler execution alerts
AWS_SNS_ALERT_TOPIC_ARN=

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

